<% content_for :head do %>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@700;900&family=DM+Sans:opsz,wght@9..40,400;9..40,500&display=swap" rel="stylesheet">
<% end %>

<style>
  /* ── Tokens ── */
  :root {
    --bg:           #0f0f0f;
    --fg:           #ffffff;
    --muted:        #484848;
    --muted-faint:  #333333;
    --surface:      #131313;
    --border:       #232323;
    --border-faint: #1c1c1c;
    --nav-link:     #444444;
    --tag-fg:       #383838;
    --footer-fg:    #252525;
    --glow:         rgba(230, 57, 70, 0.055);
    --accent:       #e63946;
    --accent-hover: #c1121f;
    --accent-ring:  rgba(230, 57, 70, 0.12);
  }

  [data-theme="light"] {
    --bg:           #f5f5f4;
    --fg:           #111111;
    --muted:        #888888;
    --muted-faint:  #aaaaaa;
    --surface:      #ffffff;
    --border:       #e2e2e0;
    --border-faint: #ececea;
    --nav-link:     #999999;
    --tag-fg:       #bbbbbb;
    --footer-fg:    #cccccc;
    --glow:         rgba(230, 57, 70, 0.04);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { transition: background 0.3s, color 0.3s; }

  body {
    font-family: 'DM Sans', -apple-system, sans-serif;
    background: var(--bg);
    color: var(--fg);
    min-height: 100vh;
    overflow-x: hidden;
    transition: background 0.3s, color 0.3s;
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background: radial-gradient(ellipse 80% 55% at 50% 38%, var(--glow) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
    transition: background 0.3s;
  }

  /* ── Navbar ── */
  .top-nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 20;
    padding: 1.5rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    opacity: 0;
    animation: fadein 0.5s ease 0.9s forwards;
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* ── Theme toggle ── */
  .theme-btn {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--surface);
    border: 1px solid var(--border);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--nav-link);
    position: relative;
    transition: border-color 0.2s, color 0.2s, background 0.3s;
    flex-shrink: 0;
  }
  .theme-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .theme-btn svg {
    position: absolute;
    transition: opacity 0.25s ease, transform 0.3s ease;
  }

  .icon-sun  { opacity: 1; transform: rotate(0deg)   scale(1);   }
  .icon-moon { opacity: 0; transform: rotate(90deg)  scale(0.4); }

  [data-theme="light"] .icon-sun  { opacity: 0; transform: rotate(-90deg) scale(0.4); }
  [data-theme="light"] .icon-moon { opacity: 1; transform: rotate(0deg)   scale(1);   }

  /* ── Hamburger ── */
  .menu-btn {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--surface);
    border: 1px solid var(--border);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    transition: border-color 0.2s, background 0.3s;
    flex-shrink: 0;
  }
  .menu-btn:hover { border-color: var(--accent); }

  .menu-btn span {
    display: block;
    width: 14px;
    height: 1.5px;
    background: var(--nav-link);
    border-radius: 2px;
    transition: background 0.2s, transform 0.3s ease, opacity 0.2s;
    transform-origin: center;
  }
  .menu-btn:hover span { background: var(--accent); }

  /* hamburger → X quando aberto */
  .menu-btn.is-open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .menu-btn.is-open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
  .menu-btn.is-open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  /* ── Overlay ── */
  .nav-overlay {
    position: fixed;
    inset: 0;
    z-index: 15;
    background: var(--bg);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }

  .nav-overlay.is-open {
    opacity: 1;
    pointer-events: all;
  }

  .overlay-links {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
  }

  .overlay-links a {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: clamp(2.8rem, 8vw, 5rem);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: var(--muted);
    text-decoration: none;
    line-height: 1.05;
    transition: color 0.15s;
  }
  .overlay-links a:hover { color: var(--fg); }
  .overlay-links a:hover em { color: var(--accent); }
  .overlay-links a em { font-style: normal; color: transparent; transition: color 0.15s; }

  .overlay-footer {
    position: absolute;
    bottom: 2rem;
    font-size: 0.68rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted-faint);
  }

  /* stagger de entrada dos links */
  .overlay-links li {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .nav-overlay.is-open .overlay-links li:nth-child(1) { opacity: 1; transform: none; transition-delay: 0.07s; }
  .nav-overlay.is-open .overlay-links li:nth-child(2) { opacity: 1; transform: none; transition-delay: 0.12s; }
  .nav-overlay.is-open .overlay-links li:nth-child(3) { opacity: 1; transform: none; transition-delay: 0.17s; }
  .nav-overlay.is-open .overlay-links li:nth-child(4) { opacity: 1; transform: none; transition-delay: 0.22s; }
  .nav-overlay.is-open .overlay-links li:nth-child(5) { opacity: 1; transform: none; transition-delay: 0.27s; }

  /* ── Hero ── */
  .hero {
    position: relative;
    z-index: 1;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem 1.5rem;
  }

  .eyebrow {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.75rem;
    opacity: 0;
    animation: slideup 0.6s ease 0.1s forwards;
  }

  .title {
    font-family: 'Barlow Condensed', sans-serif;
    font-size: clamp(5rem, 16vw, 11rem);
    font-weight: 900;
    line-height: 0.88;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--fg);
    opacity: 0;
    animation: slideup 0.7s ease 0.2s forwards;
    transition: color 0.3s;
  }
  .title em {
    font-style: normal;
    color: var(--accent);
    display: block;
  }

  .subtitle {
    margin-top: 1.5rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--muted);
    max-width: 420px;
    opacity: 0;
    animation: slideup 0.7s ease 0.35s forwards;
    transition: color 0.3s;
  }

  /* ── Search ── */
  .search-area {
    margin-top: 3rem;
    width: 100%;
    max-width: 620px;
    opacity: 0;
    animation: slideup 0.7s ease 0.5s forwards;
  }

  .search-form {
    display: flex;
    align-items: stretch;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    transition: border-color 0.2s, box-shadow 0.2s, background 0.3s;
  }
  .search-form:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-ring);
  }

  .search-icon {
    display: flex;
    align-items: center;
    padding: 0 0 0 1.25rem;
    color: var(--muted-faint);
    flex-shrink: 0;
    transition: color 0.3s;
  }

  .search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    padding: 1.1rem 1rem;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.975rem;
    color: var(--fg);
    min-width: 0;
    transition: color 0.3s;
  }
  .search-input::placeholder { color: var(--muted-faint); }

  .search-btn {
    flex-shrink: 0;
    background: var(--accent);
    border: none;
    border-radius: 0 12px 12px 0;
    padding: 0 1.6rem;
    cursor: pointer;
    color: #fff;
    font-family: 'DM Sans', sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: background 0.15s;
    white-space: nowrap;
  }
  .search-btn:hover { background: var(--accent-hover); }

  /* Quick tags */
  .quick-tags {
    margin-top: 1.1rem;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
    opacity: 0;
    animation: slideup 0.6s ease 0.65s forwards;
  }
  .quick-tag {
    font-size: 0.73rem;
    color: var(--tag-fg);
    text-decoration: none;
    padding: 0.28rem 0.8rem;
    border: 1px solid var(--border-faint);
    border-radius: 999px;
    transition: color 0.15s, border-color 0.15s;
  }
  .quick-tag:hover { color: var(--fg); border-color: var(--border); }

  /* ── Footer note ── */
  .footer-note {
    position: fixed;
    bottom: 1.75rem;
    left: 50%;
    transform: translateX(-50%);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--footer-fg);
    white-space: nowrap;
    opacity: 0;
    animation: fadein 0.5s ease 1.1s forwards;
    transition: color 0.3s;
  }

  /* ── Animations ── */
  @keyframes slideup {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadein {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
</style>

<nav class="top-nav">
  <button id="menu-toggle" class="menu-btn" aria-label="Abrir menu">
    <span></span>
    <span></span>
    <span></span>
  </button>

  <div class="nav-right">
    <button id="theme-toggle" class="theme-btn" aria-label="Alternar tema">
      <%# Sol — visível no dark mode %>
      <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
      </svg>
      <%# Lua — visível no light mode %>
      <svg class="icon-moon" width="14" height="14" viewBox="0 0 24 24" fill="none"
           stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
    </button>
  </div>
</nav>

<div id="nav-overlay" class="nav-overlay" role="dialog" aria-modal="true">
  <ul class="overlay-links">
    <li><a href="<%= vehicles_path %>">Veículos</a></li>
    <li><a href="<%= vehicles_path %>">Preços <em>FIPE</em></a></li>
    <li><a href="<%= vehicles_path %>">Especificações</a></li>
    <li><a href="<%= vehicles_path %>">Revisões</a></li>
    <li><a href="<%= vehicles_path %>">Defeitos</a></li>
  </ul>
  <p class="overlay-footer">tudodecarros.com.br</p>
</div>

<main class="hero">
  <p class="eyebrow">Preços &nbsp;·&nbsp; Fichas Técnicas &nbsp;·&nbsp; Revisões &nbsp;·&nbsp; Defeitos</p>

  <h1 class="title">
    Tudo de
    <em>Carros</em>
  </h1>

  <p class="subtitle">
    A plataforma automotiva brasileira<br>
    <span style="white-space: nowrap;">Preços, especificações, histórico de revisões e defeitos conhecidos</span>
  </p>

  <div class="search-area">
    <%= form_with url: vehicles_path, method: :get, class: "search-form" do |f| %>
      <span class="search-icon">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
        </svg>
      </span>
      <%= f.text_field :q,
          placeholder: "Pesquise por marca, modelo, versão…",
          class: "search-input",
          autocomplete: "off",
          autofocus: true %>
      <%= f.submit "Buscar", class: "search-btn" %>
    <% end %>

    <div class="quick-tags">
      <%= link_to "Toyota",      vehicles_path(q: "Toyota"),      class: "quick-tag" %>
      <%= link_to "Volkswagen",  vehicles_path(q: "Volkswagen"),  class: "quick-tag" %>
      <%= link_to "Honda",       vehicles_path(q: "Honda"),       class: "quick-tag" %>
      <%= link_to "BYD",         vehicles_path(q: "BYD"),         class: "quick-tag" %>
      <%= link_to "Corolla",     vehicles_path(q: "Corolla"),     class: "quick-tag" %>
      <%= link_to "Elétricos",   vehicles_path(q: "Electric"),    class: "quick-tag" %>
    </div>
  </div>
</main>

<p class="footer-note">tudodecarros.com.br</p>

<script>
  (function () {
    const root   = document.documentElement;
    const themeBtn = document.getElementById("theme-toggle");
    const menuBtn  = document.getElementById("menu-toggle");
    const overlay  = document.getElementById("nav-overlay");
    const stored   = localStorage.getItem("tdc-theme") || "dark";

    root.setAttribute("data-theme", stored);

    themeBtn.addEventListener("click", function () {
      const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      localStorage.setItem("tdc-theme", next);
    });

    function openMenu() {
      overlay.classList.add("is-open");
      menuBtn.classList.add("is-open");
      document.body.style.overflow = "hidden";
    }

    function closeMenu() {
      overlay.classList.remove("is-open");
      menuBtn.classList.remove("is-open");
      document.body.style.overflow = "";
    }

    menuBtn.addEventListener("click", function () {
      overlay.classList.contains("is-open") ? closeMenu() : openMenu();
    });

    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") closeMenu();
    });
  })();
</script>
