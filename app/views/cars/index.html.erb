<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #0f0f0f; color: #fff; padding: 2rem; }
  h1 { font-size: 2rem; font-weight: 700; margin-bottom: 1.5rem; }
  h1 span { color: #e63946; }
  table { width: 100%; border-collapse: collapse; }
  th { text-align: left; padding: 0.75rem 1rem; color: #aaa; font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; border-bottom: 1px solid #222; }
  td { padding: 0.75rem 1rem; border-bottom: 1px solid #1a1a1a; }
  tr:hover td { background: #161616; }
  a { color: #fff; text-decoration: none; }
  a:hover { color: #e63946; }
  .badge { display: inline-block; background: #1a1a1a; border: 1px solid #333; padding: 0.2rem 0.6rem; border-radius: 999px; font-size: 0.8rem; color: #aaa; }
</style>

<h1>Tudo de <span>Carros</span></h1>

<table>
  <thead>
    <tr>
      <th>#</th>
      <th>Marca</th>
      <th>Nome</th>
      <th>Modelo</th>
      <th>Ano</th>
    </tr>
  </thead>
  <tbody>
    <% @cars.each do |car| %>
      <tr>
        <td><span class="badge"><%= car.id %></span></td>
        <td><%= link_to car.brand, carro_path(car) %></td>
        <td><%= link_to car.name, carro_path(car) %></td>
        <td><%= car.model %></td>
        <td><%= car.year %></td>
      </tr>
    <% end %>
  </tbody>
</table>
