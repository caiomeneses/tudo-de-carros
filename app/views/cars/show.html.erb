<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #0f0f0f; color: #fff; padding: 2rem; }
  a.back { color: #aaa; text-decoration: none; font-size: 0.9rem; display: inline-block; margin-bottom: 2rem; }
  a.back:hover { color: #e63946; }
  .card { background: #161616; border: 1px solid #222; border-radius: 12px; padding: 2rem; max-width: 480px; }
  .card-title { font-size: 1.8rem; font-weight: 700; margin-bottom: 0.25rem; }
  .card-title span { color: #e63946; }
  .card-subtitle { color: #aaa; font-size: 0.95rem; margin-bottom: 2rem; }
  .field { display: flex; justify-content: space-between; padding: 0.75rem 0; border-bottom: 1px solid #1f1f1f; }
  .field:last-child { border-bottom: none; }
  .label { color: #aaa; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.06em; }
  .value { font-weight: 500; }
</style>

<%= link_to "← Voltar", carros_path, class: "back" %>

<div class="card">
  <div class="card-title"><%= @car.name %> <span><%= @car.model %></span></div>
  <div class="card-subtitle"><%= @car.brand %></div>

  <div class="field">
    <span class="label">ID</span>
    <span class="value">#<%= @car.id %></span>
  </div>
  <div class="field">
    <span class="label">Marca</span>
    <span class="value"><%= @car.brand %></span>
  </div>
  <div class="field">
    <span class="label">Nome</span>
    <span class="value"><%= @car.name %></span>
  </div>
  <div class="field">
    <span class="label">Modelo</span>
    <span class="value"><%= @car.model %></span>
  </div>
  <div class="field">
    <span class="label">Ano</span>
    <span class="value"><%= @car.year %></span>
  </div>
</div>
