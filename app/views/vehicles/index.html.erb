<style>
  :root {
    --bg:           #0f0f0f;
    --fg:           #ffffff;
    --muted:        #aaaaaa;
    --surface:      #1a1a1a;
    --surface2:     #222222;
    --border:       #222222;
    --border-hover: #333333;
    --empty-fg:     #555555;
    --accent:       #e63946;
    --nav-link:     #444444;
    --card-shadow:  rgba(0,0,0,0.4);
  }

  [data-theme="light"] {
    --bg:           #f5f5f4;
    --fg:           #111111;
    --muted:        #888888;
    --surface:      #ffffff;
    --surface2:     #f0f0ee;
    --border:       #e2e2e0;
    --border-hover: #cccccc;
    --empty-fg:     #aaaaaa;
    --nav-link:     #999999;
    --card-shadow:  rgba(0,0,0,0.08);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    background: var(--bg);
    color: var(--fg);
    min-height: 100vh;
    transition: background 0.3s, color 0.3s;
  }

  /* ── Header ── */
  .page-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 2rem;
    border-bottom: 1px solid var(--border);
  }

  .back-link {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--nav-link);
    text-decoration: none;
    transition: color 0.15s;
  }
  .back-link:hover { color: var(--accent); }

  /* ── Theme toggle ── */
  .theme-btn {
    width: 34px; height: 34px;
    border-radius: 50%;
    background: var(--surface);
    border: 1px solid var(--border);
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    color: var(--nav-link);
    position: relative; flex-shrink: 0;
    transition: border-color 0.2s, color 0.2s, background 0.3s;
  }
  .theme-btn:hover { border-color: var(--accent); color: var(--accent); }
  .theme-btn svg { position: absolute; transition: opacity 0.25s ease, transform 0.3s ease; }
  .icon-sun  { opacity: 1; transform: rotate(0deg)   scale(1);   }
  .icon-moon { opacity: 0; transform: rotate(90deg)  scale(0.4); }
  [data-theme="light"] .icon-sun  { opacity: 0; transform: rotate(-90deg) scale(0.4); }
  [data-theme="light"] .icon-moon { opacity: 1; transform: rotate(0deg)   scale(1);   }

  /* ── Hero ── */
  .hero {
    padding: 2.5rem 2rem 1.5rem;
  }
  .hero h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .hero h1 span { color: var(--accent); }
  .hero-meta {
    margin-top: 0.6rem;
    font-size: 0.85rem;
    color: var(--muted);
    transition: color 0.3s;
  }
  #meta-count { color: var(--fg); font-weight: 600; transition: color 0.3s; }

  /* ── Brand filter ── */
  .brand-section {
    padding: 0 2rem 1.5rem;
  }
  .brand-section-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }
  .brand-strip {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    padding: 3px 0 0.5rem;
    scrollbar-width: none;
  }
  .brand-strip::-webkit-scrollbar { display: none; }

  .brand-card {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s, transform 0.15s;
    min-width: 80px;
    user-select: none;
  }
  .brand-card:hover { border-color: var(--border-hover); transform: translateY(-1px); }
  .brand-card.active { border-color: var(--accent); background: rgba(230,57,70,0.06); }

  .brand-monogram {
    width: 44px; height: 44px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.1rem; font-weight: 700;
    flex-shrink: 0;
  }
  .brand-card-name {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--muted);
    text-align: center;
    transition: color 0.2s;
  }
  .brand-card.active .brand-card-name { color: var(--accent); }
  .brand-card-count {
    font-size: 0.65rem;
    color: var(--empty-fg);
  }
  .brand-card.active .brand-card-count { color: rgba(230,57,70,0.7); }

  /* ── Vehicle grid ── */
  .vehicles-section {
    padding: 0 2rem 3rem;
  }
  .vehicle-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }

  .vehicle-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 1.25rem;
    text-decoration: none;
    color: var(--fg);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: border-color 0.2s, transform 0.15s, box-shadow 0.2s;
  }
  .vehicle-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px var(--card-shadow);
    color: var(--fg);
  }

  .vc-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .vc-brand {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .vc-name {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin-top: 0.1rem;
  }
  .vc-version {
    font-size: 0.78rem;
    color: var(--muted);
    margin-top: 0.2rem;
    line-height: 1.4;
  }

  .vc-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }
  .vc-year {
    font-size: 0.8rem;
    color: var(--muted);
    font-weight: 500;
  }
  /* powertrain badges */
  .pt-badge {
    font-size: 0.65rem; font-weight: 700;
    letter-spacing: 0.06em;
    padding: 0.18rem 0.5rem;
    border-radius: 999px;
    flex-shrink: 0;
  }
  .pt-badge.bev  { background: rgba(59,130,246,0.1);  color: #3b82f6; border: 1px solid rgba(59,130,246,0.25); }
  .pt-badge.phev { background: rgba(34,197,94,0.1);   color: #16a34a; border: 1px solid rgba(34,197,94,0.25);  }
  .pt-badge.reev { background: rgba(20,184,166,0.1);  color: #0d9488; border: 1px solid rgba(20,184,166,0.25); }
  .pt-badge.hev  { background: rgba(234,179,8,0.1);   color: #ca8a04; border: 1px solid rgba(234,179,8,0.25);  }
  .pt-badge.ice  { background: rgba(251,146,60,0.08); color: #ea580c; border: 1px solid rgba(251,146,60,0.2);  }

  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 4rem 1rem;
    color: var(--empty-fg);
    font-size: 0.9rem;
  }
</style>

<header class="page-header">
  <a href="<%= root_path %>" class="back-link">← Home</a>

  <button id="theme-toggle" class="theme-btn" aria-label="Alternar tema">
    <svg class="icon-sun" width="15" height="15" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="4"/>
      <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
    </svg>
    <svg class="icon-moon" width="14" height="14" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
    </svg>
  </button>
</header>

<section class="hero">
  <h1>Todos os <span>Veículos</span></h1>
  <p class="hero-meta"><span id="meta-count"><%= @vehicle_groups.size %></span> modelos · <span id="meta-brand"><%= @brands.size %> marcas</span></p>
</section>

<section class="brand-section">
  <p class="brand-section-label">Filtrar por marca</p>
  <div class="brand-strip">
    <% @brands.each do |brand| %>
      <% count  = @vehicle_groups.count { |g| g.first.brand_id == brand.id }
         colors = %w[
           #3b82f6 #8b5cf6 #ec4899 #f59e0b #10b981
           #06b6d4 #f97316 #84cc16 #e63946 #6366f1
         ]
         color  = colors[brand.name.bytes.sum % colors.size]
      %>
      <div class="brand-card" data-brand="<%= brand.name.downcase %>">
        <div class="brand-monogram" style="background: <%= color %>1a; color: <%= color %>;">
          <%= brand.name[0].upcase %>
        </div>
        <span class="brand-card-name"><%= brand.name %></span>
        <span class="brand-card-count"><%= count %></span>
      </div>
    <% end %>
  </div>
</section>

<section class="vehicles-section">
  <div class="vehicle-grid" id="vehicle-grid">
    <% @vehicle_groups.each do |group| %>
      <% representative = group.max_by(&:year)
         brand          = representative.brand
         min_year       = group.map(&:year).min
         max_year       = group.map(&:year).max
         year_label     = min_year == max_year ? min_year.to_s : "#{min_year}–#{max_year}"
         versions_count = group.size

         pt_types = group.map { |v| v.ev_spec&.powertrain_type }.compact.uniq
         fuels    = group.map { |v| v.technical_spec&.fuel_type.to_s }.reject(&:empty?).uniq

         badges = pt_types.map { |t| [ t.downcase, t ] }
         if badges.empty?
           if fuels.any? { |f| f.downcase.include?("flex") }
             badges << [ "ice", "Flex" ]
           elsif fuels.any? { |f| f.downcase.include?("gasolina") }
             badges << [ "ice", "Gasolina" ]
           elsif fuels.any? { |f| f.downcase.include?("diesel") }
             badges << [ "ice", "Diesel" ]
           else
             badges << [ "ice", fuels.first.presence || "ICE" ]
           end
         end
      %>
      <%= link_to vehicle_model_path(brand_slug: brand.slug, model_slug: representative.model_slug),
            class: "vehicle-card",
            data: { brand: brand.name.downcase } do %>
        <div class="vc-top">
          <div>
            <div class="vc-brand"><%= brand.name %></div>
            <div class="vc-name"><%= representative.name %></div>
          </div>
          <div style="display:flex; flex-direction:column; align-items:flex-end; gap:0.3rem; flex-shrink:0;">
            <% badges.each do |bc, bl| %>
              <span class="pt-badge <%= bc %>"><%= bl %></span>
            <% end %>
          </div>
        </div>

        <div class="vc-footer">
          <div>
            <div class="vc-year"><%= year_label %></div>
            <% if versions_count > 1 %>
              <div style="font-size:0.65rem; color:var(--empty-fg); margin-top:0.1rem;"><%= versions_count %> versões</div>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>

    <% if @vehicle_groups.empty? %>
      <div class="empty-state">Nenhum veículo cadastrado.</div>
    <% end %>
  </div>
</section>

<script>
  (function () {
    const root = document.documentElement;
    const btn  = document.getElementById("theme-toggle");
    const stored = localStorage.getItem("tdc-theme") || "dark";
    root.setAttribute("data-theme", stored);
    btn.addEventListener("click", function () {
      const next = root.getAttribute("data-theme") === "dark" ? "light" : "dark";
      root.setAttribute("data-theme", next);
      localStorage.setItem("tdc-theme", next);
    });
  })();

  (function () {
    const allBrandCards = document.querySelectorAll(".brand-card");
    const maxW = Math.max(...[...allBrandCards].map(function (c) { return c.offsetWidth; }));
    allBrandCards.forEach(function (c) { c.style.width = maxW + "px"; });
  })();

  (function () {
    const brandCards   = document.querySelectorAll(".brand-card");
    const vehicleCards = document.querySelectorAll("#vehicle-grid .vehicle-card");
    const metaCount    = document.getElementById("meta-count");
    const metaBrand    = document.getElementById("meta-brand");
    const grid         = document.getElementById("vehicle-grid");

    function selectBrand(card) {
      const selected  = card.dataset.brand;
      const brandName = card.querySelector(".brand-card-name").textContent.trim();

      brandCards.forEach(function (c) { c.classList.remove("active"); });
      card.classList.add("active");

      metaBrand.textContent = brandName;

      let visible = 0;
      vehicleCards.forEach(function (vc) {
        const match = vc.dataset.brand === selected;
        vc.style.display = match ? "" : "none";
        if (match) visible++;
      });

      metaCount.textContent = visible;

      let empty = grid.querySelector(".empty-filter");
      if (visible === 0) {
        if (!empty) {
          empty = document.createElement("div");
          empty.className = "empty-state empty-filter";
          empty.textContent = "Nenhum modelo encontrado para esta marca.";
          grid.appendChild(empty);
        }
      } else if (empty) {
        empty.remove();
      }
    }

    brandCards.forEach(function (card) {
      card.addEventListener("click", function () {
        localStorage.setItem("tdc-brand", card.dataset.brand);
        selectBrand(card);
      });
    });

    var saved = localStorage.getItem("tdc-brand");
    var initial = saved && [...brandCards].find(function (c) { return c.dataset.brand === saved; });
    selectBrand(initial || brandCards[0]);
  })();
</script>
